<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Test the pure policy classes without pulling in the Functions host entry point. -->
    <Compile Include="..\CimarFunctions\Services\Sync\UnconfirmedOrderCancelPolicy.cs" Link="Policies\UnconfirmedOrderCancelPolicy.cs" />
    <Compile Include="..\CimarFunctions\Services\Sync\OrderDeliveredSyncPolicy.cs" Link="Policies\OrderDeliveredSyncPolicy.cs" />
  </ItemGroup>

</Project>
